/**
 * What the compiler carries as text, so the plugin needs no loader for it: `python/trigscript.py` — the euddraft
 * plugin that lowers the IR with eudplib, handed to the eudplib library plugin at build time — and the standard
 * library's modules, `stdlib/<name>.ts` (TrigScript, imported as "trigscript/<name>"). Run after editing either:
 * `npm run embed`. `tests/python.test.ts` and `tests/stdlib.test.ts` fail when they drift.
 */
import { readdirSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
const root = join(import.meta.dirname, "..");
const py = readFileSync(join(root, "python/trigscript.py"), "utf8");
writeFileSync(join(root, "compiler/generated/trigscriptPy.ts"), `// Generated by scripts/embed-python.mts from python/trigscript.py — do not edit.\nexport const TRIGSCRIPT_PY: string = ${JSON.stringify(py)};\n`);
console.log(`compiler/generated/trigscriptPy.ts: ${py.length} chars`);
const modules = readdirSync(join(root, "stdlib")).filter((f) => f.endsWith(".ts") || f.endsWith(".tsx")).sort();
const sources = Object.fromEntries(modules.map((f) => [f.replace(/\.tsx?$/, ""), readFileSync(join(root, "stdlib", f), "utf8")]));
// A module with JSX in it (a component of "trigscript/ui") is a .tsx file, and keeps its extension among the script's.
const extensions = Object.fromEntries(modules.map((f) => [f.replace(/\.tsx?$/, ""), f.endsWith(".tsx") ? ".tsx" : ".ts"]));
writeFileSync(join(root, "compiler/generated/stdlib.ts"), `// Generated by scripts/embed-python.mts from stdlib/*.ts and *.tsx — do not edit.\nexport const STDLIB_SOURCES: Readonly<Record<string, string>> = ${JSON.stringify(sources, null, 1)};\nexport const STDLIB_EXTENSIONS: Readonly<Record<string, ".ts" | ".tsx">> = ${JSON.stringify(extensions)};\n`);
console.log(`compiler/generated/stdlib.ts: ${modules.join(", ")}`);
